# Optional: leave unset to use built-in demo activities.
# Copy this file to .env (do not overwrite an existing .env).
# Uncomment the line below and replace the example IP with YOUR computer's
# active Ethernet/Wi-Fi IPv4 address (ipconfig on Windows), NOT Kyle's address.
# Your phone must be on the same local network as your computer.
# Match PUBLIC_BACKEND_URL in server/.env. Restart Expo after editing.
# This file contains public app configuration only; no Strava secrets here.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
