PORT=3001
# Copy this file to server/.env (do not overwrite an existing file).
# The address BOTH the phone and browser can reach. Match root EXPO_PUBLIC_API_URL.
# Replace YOUR_COMPUTER_LAN_IP with YOUR own computer's IPv4 address.
PUBLIC_BACKEND_URL=http://YOUR_COMPUTER_LAN_IP:3001
# Optional extra browser preview origin; localhost:8081 is already supported.
# DEV_WEB_ORIGIN=http://localhost:8082
# For our shared Strava registration, Kyle securely supplies these TWO values.
# They identify the application, not Kyle's athlete account.
# Server-only: never use EXPO_PUBLIC_ for these values.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# No access/refresh token is needed. Tap Connect Strava and sign into YOUR account.
# Coordinate with Kyle: the Strava application's Authorization Callback Domain
# must match YOUR_COMPUTER_LAN_IP (no scheme/port/path) when authorizing.
# This is a shared setting; see README for switching between developers.
